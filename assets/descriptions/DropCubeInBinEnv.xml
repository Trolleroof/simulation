<mujoco model="cube in bin scene">
  <compiler angle="radian" autolimits="true" meshdir="panda/mjcf"/>
  <option iterations="3" ls_iterations="5" solver="Newton" tolerance="1e-8" timestep="0.001">
    <flag eulerdamp="disable"/>
  </option>

  <include file="simpleTable/simpleTable_asset.xml"/>
  <include file="bin/bin_asset.xml"/>
  <include file="panda/mjcf/panda_asset.xml"/>
  <include file="scene.xml"/>

  <worldbody>
    <camera name="fixed" pos="1.2 -1.6 2.1" xyaxes="0.8 0.6 0 -0.3 0.4 0.86" fovy="45"/>
    <include file="simpleTable/simpleWoodTable_body.xml"/>

    <body name="panda_base" pos="-0.45 0 0.76" childclass="panda">
      <include file="panda/mjcf/panda_body.xml"/>
    </body>
    <body name="cube" pos="0.12 0.12 0.79">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" mass="0.05" rgba="0.85 0.2 0.15 1"/>
    </body>
    <body name="bin" pos="0.18 0.0 0.765">
      <include file="bin/bin_body.xml"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0 0.392699 0 -1.9635 0 2.35619 0.785398 0.04 0.04 0.12 0.12 0.79 1 0 0 0"/>
  </keyframe>
</mujoco>
